# 监听地址绑定（默认仅本地访问）
HOST_BIND=127.0.0.1

# 服务端口
PORT=8000

# worker 数量
WORKERS=1

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志格式: text / json
LOG_FORMAT=json

# 默认解析模式: lattice / stream
CAMELOT_DEFAULT_FLAVOR=lattice

# lattice 无结果时是否回退到 stream
CAMELOT_FALLBACK_STREAM=true

# PDF 文件大小上限 (MB)
MAX_PDF_SIZE_MB=200

# PDF 数据目录（挂载到容器内 /data/pdf，只读）
PDF_DATA_DIR=./data/pdf

# 上传文件存储目录
UPLOAD_DIR=/var/lib/camelot-api/uploads

# 上传文件大小上限 (MB)，默认复用 MAX_PDF_SIZE_MB
UPLOAD_MAX_SIZE_MB=200

# 上传文件保留时长（小时），过期后由定时任务清理
UPLOAD_TTL_HOURS=24

# 定时清理间隔（分钟）
UPLOAD_CLEANUP_INTERVAL_MINUTES=30

# 结果缓存最大条目数
CACHE_MAX_ENTRIES=1000
