# 监听地址绑定（默认仅本地访问）
HOST_BIND=127.0.0.1

# 服务端口
PORT=8000

# worker 数量
WORKERS=1

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志格式: text / json
LOG_FORMAT=json

# 默认解析模式: lattice / stream
CAMELOT_DEFAULT_FLAVOR=lattice

# lattice 无结果时是否回退到 stream
CAMELOT_FALLBACK_STREAM=true

# PDF 文件大小上限 (MB)
MAX_PDF_SIZE_MB=200

# PDF 数据目录（挂载到容器内 /data/pdf，只读）
PDF_DATA_DIR=./data/pdf
