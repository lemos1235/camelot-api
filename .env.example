# =============================================================================
# Docker Compose 应用参数示例
# 复制为 .env 后按需修改。本文件被 docker-compose 通过 env_file 注入容器，
# 覆盖 config.toml 中的同名值。全部保持注释即用内置默认值，可不创建 .env。
# 裸机 / systemd 部署请改用项目根的 config.toml（复制 config.toml.example）。
# 对外端口、绑定地址、PDF / 上传目录挂载等编排项见 docker-compose.yml 内的默认值。
# =============================================================================

# ---- 应用参数（通过 env_file 注入容器，覆盖 config.toml） ----

# worker 数量
# WORKERS=1

# 日志级别: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# 日志格式: text / json
# LOG_FORMAT=json

# 默认解析模式: lattice / stream
# CAMELOT_DEFAULT_FLAVOR=lattice

# lattice 无结果时是否回退到 stream
# CAMELOT_FALLBACK_STREAM=true

# 线条缩放参数
# CAMELOT_LINE_SCALE=15

# PDF 大小基线 (MB)，作为上传 / 下载大小上限的默认值
# MAX_PDF_SIZE_MB=200

# 上传文件大小上限 (MB)，默认复用 MAX_PDF_SIZE_MB
# UPLOAD_MAX_SIZE_MB=200

# 上传文件保留时长（小时），过期后由定时任务清理
# UPLOAD_TTL_HOURS=24

# 定时清理间隔（分钟）
# UPLOAD_CLEANUP_INTERVAL_MINUTES=30

# 结果缓存最大条目数
# CACHE_MAX_ENTRIES=1000

# 远程 PDF 下载超时（秒）
# URL_DOWNLOAD_TIMEOUT_SECONDS=30

# 远程 PDF 大小上限 (MB)，默认复用 UPLOAD_MAX_SIZE_MB
# URL_MAX_SIZE_MB=200